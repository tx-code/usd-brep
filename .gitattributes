/.gitattributes text eol=lf
/.gitignore text eol=lf
/AGENTS.md text eol=lf
/GLOSSARY.md text eol=lf
/premake5.lua text eol=lf
/.scratch/ap203e2-planar-import/** text eol=lf
/docs/step-import/** text eol=lf
/docs/step-import-repair-*.md text eol=lf
/source/STEP_*/** text eol=lf
/cmake/** text eol=lf
/third_party/README.md text eol=lf
# Preserve the pinned upstream bytes, including license and provenance.
/third_party/microsoft-gsl/** -text -whitespace
/tools/step_*_validation/** text eol=lf
/tools/step_evidence/** text eol=lf
# Frozen evidence and schema witnesses are content-addressed byte artifacts.
/tools/step_import_validation/corpus/** -text
/tools/step_semantic_validation/contracts/** -text
/tools/step_planar_validation/contracts/** -text
