ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('AP203e2 planar profile design fixture'),'2;1');
FILE_NAME('p0-analytic-design.step','2026-10-15T00:00:00',('P0'),('local'),'P0 design only','synthetic analytic oracle','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN {1 0 10303 214 3 1 1}'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('configuration controlled 3d design of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2010,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('P0-PART','P0 analytic fixture',$,(#3));
#5=PRODUCT_DEFINITION_FORMATION('A',$,#4);
#6=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7=PRODUCT_DEFINITION('D1',$,#5,#6);
#8=PRODUCT_DEFINITION_SHAPE('',$,#7);
#9=SHAPE_DEFINITION_REPRESENTATION(#8,#20);
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11)) REPRESENTATION_CONTEXT('local','3D'));
/* Public analytic wire-only definition. Source parameters of the quadratic
   are t in [2,5], s=(t-2)/3, C=(2s,4s(1-s),0). Selected [2.75,4.25], reverse.
   Source cut points are exactly (.5,.75,0) and (1.5,.75,0). */
#20=GEOMETRICALLY_BOUNDED_WIREFRAME_SHAPE_REPRESENTATION('wire',(#21,#40),#12);
#21=GEOMETRIC_CURVE_SET('',(#30,#31,#32));
#22=LINE('',#23,#25);
#23=CARTESIAN_POINT('',(0.,0.,0.));
#24=DIRECTION('',(1.,0.,0.));
#25=VECTOR('',#24,8.);
#26=B_SPLINE_CURVE_WITH_KNOTS('',2,(#27,#28,#29),.UNSPECIFIED.,.F.,.F.,(3,3),(2.,5.),.UNSPECIFIED.);
#27=CARTESIAN_POINT('',(0.,0.,0.));
#28=CARTESIAN_POINT('',(1.,2.,0.));
#29=CARTESIAN_POINT('',(2.,0.,0.));
#30=TRIMMED_CURVE('',#22,(PARAMETER_VALUE(0.25)),(PARAMETER_VALUE(0.75)),.T.,.PARAMETER.);
#31=TRIMMED_CURVE('',#26,(PARAMETER_VALUE(4.25),#33),(PARAMETER_VALUE(2.75),#34),.F.,.PARAMETER.);
#32=CARTESIAN_POINT('',(7.,8.,9.));
#33=CARTESIAN_POINT('',(1.5,0.75,0.));
#34=CARTESIAN_POINT('',(0.5,0.75,0.));
#40=AXIS2_PLACEMENT_3D('',#23,$,#24);
#41=AXIS2_PLACEMENT_3D('',#23,$,#24);
#50=SHAPE_REPRESENTATION('parent',(#41),#61);
#51=PRODUCT('wire-parent','public wire parent',$,(#3));
#52=PRODUCT_DEFINITION_FORMATION('A',$,#51);
#53=PRODUCT_DEFINITION('parent',$,#52,#6);
#54=PRODUCT_DEFINITION_SHAPE('',$,#53);
#55=SHAPE_DEFINITION_REPRESENTATION(#54,#50);
#56=NEXT_ASSEMBLY_USAGE_OCCURRENCE('wire-use','wire use',$,#53,#7,$);
#57=PRODUCT_DEFINITION_SHAPE('',$,#56);
#58=CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#59,#57);
#59=(REPRESENTATION_RELATIONSHIP('',$,#20,#50) REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#60) SHAPE_REPRESENTATION_RELATIONSHIP());
#60=ITEM_DEFINED_TRANSFORMATION('',$,#40,#41);
#61=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11)) REPRESENTATION_CONTEXT('parent','3D'));
ENDSEC;
END-ISO-10303-21;
