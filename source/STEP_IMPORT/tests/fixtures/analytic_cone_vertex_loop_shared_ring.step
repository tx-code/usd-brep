#104=DIRECTION('',(0.,0.,1.));
#105=DIRECTION('',(1.,0.,0.));
#106=AXIS2_PLACEMENT_3D('',#100,#104,#105);
#110=CIRCLE('',#106,3.);
#120=VERTEX_POINT('',#102);
#122=VERTEX_POINT('',#103);
#130=EDGE_CURVE('',#120,#120,#110,.T.);
#140=PLANE('',#206);
#142=CONICAL_SURFACE('',#106,3.,-0.7853981633974483);
#150=ORIENTED_EDGE('',*,*,#230,.F.);
#152=ORIENTED_EDGE('',*,*,#130,.T.);
#160=EDGE_LOOP('',(#150));
#162=EDGE_LOOP('',(#152));
#164=VERTEX_LOOP('',#122);
