#20=ADVANCED_BREP_SHAPE_REPRESENTATION('body',(#21),#12);
#21=MANIFOLD_SOLID_BREP('',#22);
#22=CLOSED_SHELL('',(#180,#280,#182));
#100=CARTESIAN_POINT('',(0.,0.,0.));
#102=CARTESIAN_POINT('',(3.,0.,0.));
