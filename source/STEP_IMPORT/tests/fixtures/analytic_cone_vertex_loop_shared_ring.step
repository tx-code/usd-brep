ISO-10303-21;
/* SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
   SPDX-License-Identifier: Apache-2.0
   Public synthetic cone on a cylindrical stem, radius 3 mm, cone H=3, stem H=2.
   Independent volume 27*pi, area pi*(21+9*sqrt(2)).
   Circular ring anchors differ by a quarter turn, forcing a global shared split.
   The cone still retains its original circular basis and apex vertex loop.
   The source decimal semi-angle is nearest to -pi/4.
   The side has an EDGE_LOOP circle and a distinct apex VERTEX_LOOP.
   Neither side bound is labelled FACE_OUTER_BOUND. No source seam exists. */
HEADER;
FILE_DESCRIPTION(('Public conical point-boundary control'),'2;1');
FILE_NAME('analytic-cone-vertex-loop-shared-ring.step','2026-10-26T00:00:00',('SDK'),('local'),'synthetic','independent analytic oracle','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN {1 0 10303 214 3 1 1}'));
ENDSEC;
DATA;
