#32=CARTESIAN_POINT('',(-2.,9.,0.));
#33=CARTESIAN_POINT('',(4.,-3.,0.));
#34=CARTESIAN_POINT('',(4.,9.,0.));
#35=CARTESIAN_POINT('',(1.,-3.,0.));
