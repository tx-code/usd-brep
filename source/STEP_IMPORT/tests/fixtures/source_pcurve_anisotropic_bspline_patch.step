ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Public AP214 anisotropic B-spline pcurve control'),'2;1');
FILE_NAME('public-bss-pcurve-chart.step','2026-10-15T00:00:00',('P0'),('local'),'P0 design only','synthetic analytic oracle','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN {1 0 10303 214 3 1 1}'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('configuration controlled 3d design of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2010,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('P0-PART','P0 analytic fixture',$,(#3));
#5=PRODUCT_DEFINITION_FORMATION('A',$,#4);
#6=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7=PRODUCT_DEFINITION('D1',$,#5,#6);
#8=PRODUCT_DEFINITION_SHAPE('',$,#7);
#9=SHAPE_DEFINITION_REPRESENTATION(#8,#20);
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11)) REPRESENTATION_CONTEXT('local','3D'));
/* Public analytic C(t)=(2t-1,(2t-1)^2,0), t in [0,1].
The carrier S(u,v)=(256u,v,0) has an anisotropic UV chart.
The closed region lies between C and y=1, with exact area 4/3 mm^2. */
#20=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('public chart patch',(#21),#12);
#21=SHELL_BASED_SURFACE_MODEL('',(#22));
#22=OPEN_SHELL('',(#23));
#23=ADVANCED_FACE('',(#24),#30,.T.);
#24=FACE_OUTER_BOUND('',#25,.T.);
#25=EDGE_LOOP('',(#60,#61));
#30=B_SPLINE_SURFACE_WITH_KNOTS('',1,1,((#31,#32),(#33,#34)),.PLANE_SURF.,.F.,.F.,.F.,(2,2),(2,2),(-0.00390625,0.00390625),(-1.,1.),.UNSPECIFIED.);
#31=CARTESIAN_POINT('',(-1.,-1.,0.));
#32=CARTESIAN_POINT('',(-1.,1.,0.));
#33=CARTESIAN_POINT('',(1.,-1.,0.));
#34=CARTESIAN_POINT('',(1.,1.,0.));
#35=CARTESIAN_POINT('',(0.,-1.,0.));
#41=VERTEX_POINT('',#32);
#42=VERTEX_POINT('',#34);
#43=B_SPLINE_CURVE_WITH_KNOTS('',2,(#32,#35,#34),.UNSPECIFIED.,.F.,.F.,(3,3),(0.,1.),.UNSPECIFIED.);
#44=SURFACE_CURVE('',#43,(#45),.PCURVE_S1.);
#45=PCURVE('',#30,#46);
#46=DEFINITIONAL_REPRESENTATION('',(#47),#48);
#47=B_SPLINE_CURVE_WITH_KNOTS('',2,(#49,#50,#51),.UNSPECIFIED.,.F.,.F.,(3,3),(0.,1.),.UNSPECIFIED.);
#48=(GEOMETRIC_REPRESENTATION_CONTEXT(2) PARAMETRIC_REPRESENTATION_CONTEXT() REPRESENTATION_CONTEXT('','2D'));
#49=CARTESIAN_POINT('',(-0.00390625,1.));
#50=CARTESIAN_POINT('',(0.,-1.));
#51=CARTESIAN_POINT('',(0.00390625,1.));
#52=EDGE_CURVE('',#41,#42,#44,.T.);
#53=LINE('',#34,#54);
#54=VECTOR('',#55,1.);
#55=DIRECTION('',(-1.,0.,0.));
#56=EDGE_CURVE('',#42,#41,#53,.T.);
#60=ORIENTED_EDGE('',*,*,#52,.T.);
#61=ORIENTED_EDGE('',*,*,#56,.T.);
ENDSEC;
END-ISO-10303-21;
