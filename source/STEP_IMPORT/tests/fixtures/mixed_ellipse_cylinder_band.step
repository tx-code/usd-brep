   Public independently authored mixed circular/elliptic cylindrical band. */
HEADER;
FILE_DESCRIPTION(('Public cylinder band with a mixed elliptic boundary'),'2;1');
FILE_NAME('mixed-ellipse-cylinder-band.step','2026-10-25T00:00:00',('P0'),('local'),'P0','synthetic analytic oracle','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN {1 0 10303 214 3 1 1}'));
ENDSEC;
DATA;
/* Independent oracle: radius 2, bottom z=-2; the upper boundary is z=1
   on the left half and z=1+0.75*x on the right half. Area=12*pi+6.
   Source two-loop open-surface role; preserve the complete ellipse and its
   original endpoints when adding a target meridian through its interior. */
#1=APPLICATION_CONTEXT('configuration controlled 3d design of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2010,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('P0','Public linear extrusion patch',$,(#3));
#5=PRODUCT_DEFINITION_FORMATION('A',$,#4);
#6=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7=PRODUCT_DEFINITION('D1',$,#5,#6);
#8=PRODUCT_DEFINITION_SHAPE('',$,#7);
#9=SHAPE_DEFINITION_REPRESENTATION(#8,#20);
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11)) REPRESENTATION_CONTEXT('local','3D'));
/* Public exact cubic oracle: C(t)=(12*t*(1-t),12*t*t*(1-t),0), t in[0,1].
   Source edge starts/ends at t=.5, C(.5)=(3,1.5,0), and covers one whole loop.
   The natural closure at (0,0,0) is a regular corner, not an inferred period.
   Oriented enclosed area=12/5 mm2; OpenSurfaceModel role. */
#20=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#21),#12);
#21=SHELL_BASED_SURFACE_MODEL('',(#22));
#22=OPEN_SHELL('',(#23));
#23=ADVANCED_FACE('',(#24,#26),#30,.T.);
#24=FACE_OUTER_BOUND('',#25,.T.);
#25=EDGE_LOOP('',(#80));
#26=FACE_BOUND('',#27,.T.);
#27=EDGE_LOOP('',(#81,#82));
#30=CYLINDRICAL_SURFACE('',#31,2.);
#31=AXIS2_PLACEMENT_3D('',#32,#33,#34);
#32=CARTESIAN_POINT('',(0.,0.,0.));
#33=DIRECTION('',(0.,0.,1.));
#34=DIRECTION('',(1.,0.,0.));
#40=CIRCLE('',#41,2.);
#41=AXIS2_PLACEMENT_3D('',#42,#33,#34);
#42=CARTESIAN_POINT('',(0.,0.,-2.));
#43=CIRCLE('',#44,2.);
#44=AXIS2_PLACEMENT_3D('',#45,#33,#34);
#45=CARTESIAN_POINT('',(0.,0.,1.));
#50=ELLIPSE('',#51,2.5,2.);
#51=AXIS2_PLACEMENT_3D('',#52,#53,#54);
#52=CARTESIAN_POINT('',(0.,0.,1.));
#53=DIRECTION('',(-3.,0.,4.));
#54=DIRECTION('',(4.,0.,3.));
#60=CARTESIAN_POINT('',(2.,0.,-2.));
#61=CARTESIAN_POINT('',(0.,2.,1.));
#62=CARTESIAN_POINT('',(0.,-2.,1.));
#64=VERTEX_POINT('',#60);
#65=VERTEX_POINT('',#61);
#66=VERTEX_POINT('',#62);
#70=EDGE_CURVE('',#64,#64,#40,.T.);
#71=EDGE_CURVE('',#65,#66,#43,.T.);
#72=EDGE_CURVE('',#66,#65,#50,.T.);
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#71,.F.);
#82=ORIENTED_EDGE('',*,*,#72,.F.);
ENDSEC;
END-ISO-10303-21;
