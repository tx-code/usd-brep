HEADER;
FILE_DESCRIPTION(('Public closed nonperiodic cubic with interior phase vertex'),'2;1');
FILE_NAME('closed-spline-phase.step','2026-10-25T00:00:00',('P0'),('local'),'P0','synthetic analytic oracle','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN {1 0 10303 214 3 1 1}'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('configuration controlled 3d design of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2010,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('P0','Public linear extrusion patch',$,(#3));
#5=PRODUCT_DEFINITION_FORMATION('A',$,#4);
#6=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7=PRODUCT_DEFINITION('D1',$,#5,#6);
#8=PRODUCT_DEFINITION_SHAPE('',$,#7);
#9=SHAPE_DEFINITION_REPRESENTATION(#8,#20);
#10=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#12=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11)) REPRESENTATION_CONTEXT('local','3D'));
/* Independent public sphere cap: sphere radius5 at origin, plane x=4,
   intersection circle radius3. Desired open cap x>=4 has area10*pi.
   The closed boundary crosses the source sphere longitude seam twice. */
#20=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#21),#12);
#21=SHELL_BASED_SURFACE_MODEL('',(#22));
#22=OPEN_SHELL('',(#23));
#23=ADVANCED_FACE('',(#24),#30,.T.);
#24=FACE_OUTER_BOUND('',#25,.T.);
#25=EDGE_LOOP('',(#80));
#30=SPHERICAL_SURFACE('',#31,5.);
#31=AXIS2_PLACEMENT_3D('',#41,#32,#33);
#32=DIRECTION('',(0.,0.,1.));
#33=DIRECTION('',(1.,0.,0.));
#40=CIRCLE('',#44,3.);
#41=CARTESIAN_POINT('',(0.,0.,0.));
#42=CARTESIAN_POINT('',(4.,0.,0.));
#43=DIRECTION('',(0.,1.,0.));
#44=AXIS2_PLACEMENT_3D('',#42,#33,#43);
#50=CARTESIAN_POINT('',(4.,3.,0.));
#60=VERTEX_POINT('',#50);
#74=EDGE_CURVE('',#60,#60,#40,.T.);
#80=ORIENTED_EDGE('',*,*,#74,.T.);
ENDSEC;
