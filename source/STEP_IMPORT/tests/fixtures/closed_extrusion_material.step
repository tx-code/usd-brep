#71=B_SPLINE_CURVE_WITH_KNOTS('',3,(#144,#145,#146,#144),.UNSPECIFIED.,.T.,.F.,(4,4),(0.,1.),.UNSPECIFIED.);
#50=CARTESIAN_POINT('',(3.,1.5,0.));
#51=CARTESIAN_POINT('',(3.,1.5,5.));
#60=VERTEX_POINT('',#50);
#61=VERTEX_POINT('',#51);
#74=EDGE_CURVE('',#60,#60,#70,.T.);
#75=EDGE_CURVE('',#61,#61,#71,.T.);
#80=ORIENTED_EDGE('',*,*,#74,.T.);
#81=ORIENTED_EDGE('',*,*,#75,.F.);
#123=ADVANCED_FACE('',(#124),#130,.F.);
