# Recreated by the repository build and dependency tools.
/_build/
/_compiler/
/_repo/
/_builtpackages/

# Per-machine plans, handoffs and execution records.
/.local/
/.learning/
/.scratch/

# Session planning and raw evidence belong under .local/, not published docs.
/docs/wayfinder/
/docs/**/tickets/
/docs/**/evidence/

# Python environments, bytecode and tool caches.
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local IDE and OS state.
/.vs/
*.vcxproj.user
*.suo
.DS_Store
Thumbs.db
Desktop.ini

# Native regression programs recreate these artifacts.
/tests/prog_test/OutputFiles/
